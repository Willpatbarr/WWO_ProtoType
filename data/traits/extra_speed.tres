op = 1
value = 0.1

[resource]
script = ExtResource("1_trait")
id = "extra_speed"
display_name = "Extra Speed"
description = "Walk, sprint and crouch 10% faster."
flora = "voltvine"
order = 0
mods = Array[ExtResource("2_mod")]([SubResource("mod0"), SubResource("mod1"), SubResource("mod2")])
