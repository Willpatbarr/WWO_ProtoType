[gd_resource type="Resource" script_class="TraitData" format=3]

[ext_resource type="Script" path="res://flora/trait_data.gd" id="1_trait"]
[ext_resource type="Script" path="res://stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="mod0"]
script = ExtResource("2_mod")
stat = "walk_speed"
op = 1
value = 0.1

[sub_resource type="Resource" id="mod1"]
script = ExtResource("2_mod")
stat = "sprint_speed"
op = 1
value = 0.1

[sub_resource type="Resource" id="mod2"]
script = ExtResource("2_mod")
