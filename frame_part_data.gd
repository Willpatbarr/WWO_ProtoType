class_name FramePartData
extends Resource
# One frame part. Parts give points in the stat groups (see Modifiers.GROUPS):
# each point moves every stat in that group a little. Each part lives as a .tres in
# res://data/frame_parts/, generated by tools/build_frame_parts.gd.

@export var id := ""
@export var display_name := ""
@export_enum("head", "arms", "legs", "core") var slot := "legs"
@export var order := 0
@export var unlocked := true
@export var agility := 0.0
@export var aerial := 0.0
@export var dexterity := 0.0
@export var durability := 0.0


# Body color for each stat group. A part takes the color of its spike (+2) group;
# Standard parts (no points) leave the body its base color.
const GROUP_COLORS := {
	"agility": Color(0.3, 0.75, 0.35), # green
	"aerial": Color(0.35, 0.75, 0.95), # sky blue
	"dexterity": Color(0.95, 0.75, 0.2), # gold
	"durability": Color(0.62, 0.62, 0.66), # steel gray
}


func spike_group() -> String:
	# The group this part gives the most points to, or "" for none.
	var best := ""
	var best_points := 0.0
	for group in Modifiers.GROUPS:
		if points(group) > best_points:
			best = group
			best_points = points(group)
	return best


func body_color(base: Color) -> Color:
	var group := spike_group()
	return GROUP_COLORS[group] if group != "" else base


func points(group: String) -> float:
	return get(group)


func summary() -> String:
	var lines := []
	for group in Modifiers.GROUPS:
		var pts := points(group)
		if absf(pts) >= 0.01:
			lines.append("%s %+d" % [group.capitalize(), roundi(pts)])
	return "No changes" if lines.is_empty() else "\n".join(lines)
