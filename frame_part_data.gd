class_name FramePartData
extends Resource
# One frame part. Parts only change mechanical stats (movement and handling),
# through a list of StatModifiers. Each lives as a .tres in res://data/frame_parts/,
# generated by tools/build_frame_parts.gd.

@export var id := ""
@export var display_name := ""
@export_enum("legs", "core", "arms") var slot := "legs"
@export var order := 0
@export var unlocked := true
@export var modifiers: Array[StatModifier] = []


func summary() -> String:
	if modifiers.is_empty():
		return "No changes"
	return "\n".join(modifiers.map(func(m: StatModifier) -> String: return m.describe()))
